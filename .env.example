# --- Database (web/Prisma owns the connection) ---
# Local dev:
DATABASE_URL=postgresql://tianming:tianming@localhost:5432/tianming
# VPS (docker compose): host is the existing bazi-db container on bazi_baznet
# DATABASE_URL=postgresql://tianming:secret@bazi-db:5432/tianming?schema=public

# --- Engine ---
ENGINE_URL=http://localhost:8000
# VPS (docker compose): ENGINE_URL=http://lottery-engine:8000
TIANMING_DATA_XLSX=./data/thai.xlsx

# --- NextAuth v5 (Phase 6) ---
AUTH_SECRET=change-me-in-production
# LINE OAuth (optional — provider enabled only when both are set)
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
# Facebook OAuth (optional)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Membership / Auth ---
SEED_ADMIN_EMAIL=admin@tianming.local
SEED_ADMIN_PASSWORD=
SESSION_TTL_HOURS=8

# --- Audit Logging ---
AUDIT_LOG_DIR=./logs
AUDIT_LOG_RETENTION_DAYS=90
